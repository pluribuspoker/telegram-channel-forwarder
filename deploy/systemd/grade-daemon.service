[Unit]
Description=Pick Grade Daemon (Bot API only, no Telethon)
After=network.target

[Service]
Type=simple
User=forwarder
WorkingDirectory=/home/forwarder/app
EnvironmentFile=/home/forwarder/app/.env
EnvironmentFile=-/home/forwarder/app/.env.local
ExecStart=/home/forwarder/app/run_grade_daemon.sh
# glibc caps arenas at 8x cores; freed memory pinned in per-thread arenas sat
# idle in swap (telegram-intake: ~690MB, 2026-09-30). 2 is plenty under the GIL.
Environment=MALLOC_ARENA_MAX=2
# One journal line on every stop: systemd result, who requested it, memory per unit (deploy/stop_context.py).
ExecStopPost=/usr/bin/python3 /home/forwarder/app/deploy/stop_context.py --stop grade-daemon.service
Restart=on-failure
RestartSec=5
# Watchdog: the daemon sends WATCHDOG=1 every loop iteration (~10s). If it
# wedges and stops notifying for this long, systemd restarts it. Set well
# above CYCLE_TIMEOUT (300s) so a single slow cycle never trips it.
WatchdogSec=600
NotifyAccess=main
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
